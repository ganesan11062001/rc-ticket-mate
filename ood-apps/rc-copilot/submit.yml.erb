---
<%-
  hours  = bc_num_hours.to_i
  part   = partition.to_s
  layout = gpu_layout.to_s

  model = rc_model.to_s

  # GLM-4.5-Air does not fit in anything smaller, so don't let the form produce
  # a combination that is guaranteed to OOM at load.
  layout = "4x" if model == "air"

  # 4-bit AWQ builds are T4-sized; force the layout so the form cannot produce
  # a 4-bit model on an 80 GB card or a GLM model on a T4.
  layout = "t4"    if model.start_with?("t4-")
  layout = "1x40"  if model == "qwen7b"
  layout = "1x80"  if model == "flash"

  # The 3B test model is ~6 GB and runs anywhere with sm_75+.
  layout = "small" if model == "small"

  case layout
  when "t4"
    # Single T4. 4-bit weights leave room for KV; the node has plenty of RAM.
    gres       = "gpu:t4:1"
    constraint = ""
    mem        = 48
    cpus       = 8
  when "1x40"
    # 40 GB A100, no feature constraint needed.
    gres       = "gpu:a100:1"
    constraint = ""
    mem        = 80
    cpus       = 12
  when "small"
    gres       = "gpu:1"
    constraint = ""
    mem        = 32
    cpus       = 8
  when "1x80"
    # Weights are ~56 GiB on one card, so a 40GB A100 cannot hold them at all.
    gres       = "gpu:a100:1"
    constraint = "a100@80g"
    mem        = 120
    cpus       = 16
  when "4x"
    gres       = "gpu:a100:4"
    constraint = ""
    mem        = 380
    cpus       = 16
  else
    gres       = "gpu:a100:2"
    constraint = ""
    mem        = 200
    cpus       = 16
  end

  # Every general-access GPU partition caps GRES at one GPU per job, so asking
  # for more anywhere but multigpu is rejected with QOSMaxGRESPerJob. Redirect
  # it, so the failure is an honest "you need multigpu access" instead.
  part = "multigpu" if ["2x", "4x"].include?(layout)

  # Partition time ceilings, per https://rc.northeastern.edu/partitions .
  # The form's data-max-bc-num-hours already does this in the browser; this is
  # the backstop for a cached or hand-edited value.
  max_hours = { "gpu-interactive" => 2, "gpu-short" => 2, "gpu" => 8,
                "multigpu" => 24 }.fetch(part, 2)
  hours = max_hours if hours > max_hours
  hours = 1 if hours < 1
-%>
batch_connect:
  template: "basic"

script:
  native:
    - "--partition=<%= part %>"
    - "--gres=<%= gres %>"
<%- unless constraint.empty? -%>
    - "--constraint=<%= constraint %>"
<%- end -%>
    - "--cpus-per-task=<%= cpus %>"
    - "--mem=<%= mem %>G"
    - "--time=<%= hours %>:00:00"
    - "--job-name=rc-copilot"
